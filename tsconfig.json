{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts"]
}